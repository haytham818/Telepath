<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Telepath.Godot</RootNamespace>
    <AssemblyName>Telepath.Godot</AssemblyName>
    <Description>Godot integration layer for Telepath.</Description>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Match Godot.NET.Sdk defines needed by EditorPlugin and Godot APIs. -->
    <DefineConstants>$(DefineConstants);GODOT;TOOLS</DefineConstants>
    <GodotProjectDir>$(TelepathRepoRoot)</GodotProjectDir>
    <IsGodotToolsProject>true</IsGodotToolsProject>
    <!-- Library types are not host scripts; skip ScriptPath and game Main. Keep ScriptMethods so View._Ready is registered. -->
    <GodotDisabledSourceGenerators>ScriptPathAttribute;GodotPluginsInitializer</GodotDisabledSourceGenerators>
  </PropertyGroup>
  <ItemGroup>
    <!-- Godot only resolves C# scripts from the host assembly; keep Node scripts there. -->
    <Compile Remove="R3/FrameProviderDispatcher.cs" />
    <Compile Remove="Editor/TelepathEditorPlugin.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.7.1" />
    <PackageReference Include="GodotSharpEditor" Version="4.7.1" />
    <PackageReference Include="Godot.SourceGenerators" Version="4.7.1" PrivateAssets="all" />
    <ProjectReference Include="..\Core\Telepath.Core.csproj" />
  </ItemGroup>
</Project>
