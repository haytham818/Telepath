[gd_scene format=3 uid="uid://c8telepathdir"]

[ext_resource type="Script" path="res://Shell/DirectoryView.cs" id="1_dir"]

[node name="DirectoryView" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_dir")
metadata/telepath_bindings = [{
"kind": "Command",
"member": "OpenCounterCommand",
"path": "%Counter"
}, {
"kind": "Command",
"member": "OpenSearchCommand",
"path": "%Search"
}, {
"kind": "Command",
"member": "OpenListCommand",
"path": "%List"
}, {
"kind": "Command",
"member": "OpenTodoCommand",
"path": "%Todo"
}, {
"kind": "Command",
"member": "OpenFormCommand",
"path": "%Form"
}, {
"kind": "Command",
"member": "OpenPauseDemoCommand",
"path": "%PauseDemo"
}, {
"kind": "Command",
"member": "OpenBannerCommand",
"path": "%Banner"
}]

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0

[node name="Center" type="CenterContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="VBox" type="VBoxContainer" parent="Scroll/Center"]
custom_minimum_size = Vector2(460, 0)
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Scroll/Center/VBox"]
layout_mode = 2
text = "Telepath Showcase"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="Scroll/Center/VBox"]
layout_mode = 2
text = "Thin views; bindings live on the scene. Counter fades on navigate. Overlays animate open and close."
autowrap_mode = 3
horizontal_alignment = 1

[node name="BindingsHeader" type="Label" parent="Scroll/Center/VBox"]
