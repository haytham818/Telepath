[gd_scene format=3 uid="uid://c8telepathcfm"]

[ext_resource type="Script" path="res://Shell/ConfirmView.cs" id="1_confirm"]

[node name="ConfirmView" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_confirm")
mouse_filter = 0
metadata/telepath_bindings = [{
"kind": "Text",
"member": "Title",
"path": "%Title"
}, {
"kind": "Text",
"member": "Message",
"path": "%Message"
}, {
"kind": "Command",
"member": "NoCommand",
"path": "%No"
}, {
"kind": "Command",
"member": "YesCommand",
"path": "%Yes"
}]

[node name="Dimmer" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0, 0, 0, 0.55)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
