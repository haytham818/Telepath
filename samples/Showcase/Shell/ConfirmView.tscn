horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="No" type="Button" parent="Center/Panel/Margin/VBox/Buttons"]
